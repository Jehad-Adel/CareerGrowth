# Docker reads the .dockerignore next to the *context*, and the context for
# backend/Dockerfile is the repo root (Railway's dockerfilePath does not move
# it). backend/.dockerignore was therefore never applied and has been deleted;
# this is the only one Docker reads. Do not add one under backend/.

# Never ship secrets into a build snapshot. The root .env holds real Supabase
# and provider credentials; nothing COPYs it, but the whole context is
# uploaded to the builder regardless of what the Dockerfile asks for.
.env
.env.*
!.env.example

# Not part of the API image, and by far the largest thing in the repo.
frontend/
docs/
knowledge_base/
.github/
.claude/
.superpowers/

.git/
.gitignore

*.md

backend/.venv/
backend/tests/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
