# ============================================================
# CareerFarm — single env file for BOTH apps (backend + frontend)
# Copy to .env and fill in. Backend reads this file directly;
# frontend loads it via dotenv-cli in its npm scripts.
#
# In production these are set as platform env vars instead:
# Vercel (frontend, NEXT_PUBLIC_* only) and Railway (backend).
# ============================================================

# --- Supabase project (shared; same project for both apps) ---
# Backend uses SUPABASE_URL; frontend needs the NEXT_PUBLIC_ copy
# (same value) because browser vars must be prefixed.
SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co

# --- Backend only (secrets — never exposed to the browser) ---
# Postgres connection string. Use the *transaction pooler* (port 6543)
# for the running app — Railway dynos hold too many direct connections.
# Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct connection (port 5432). Alembic migrations only — the pooler
# does not support the session-level statements DDL needs.
DIRECT_DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# No JWT secret is needed. Supabase signs access tokens with a rotating
# ES256 key; the backend fetches the public half from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json and verifies against that.
# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key
# Comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse proxies in front of the app, for reading the real
# client IP out of X-Forwarded-For. 0 = no proxy, trust the socket peer
# (correct here, for local dev). Railway should set this to 1.
TRUSTED_PROXY_COUNT=0

# Sentry DSN. Optional: unset means no error reporting is initialised.
SENTRY_DSN=
# development | production. Production disables /docs and adds HSTS.
ENVIRONMENT=development

# --- Frontend only (NEXT_PUBLIC_ = exposed to the browser) ---
# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public origin, used for canonical URLs, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase anon/public key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
